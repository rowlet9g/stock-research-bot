# Copy this file to .env and fill in local secrets.
# Do not commit .env.

OPENDART_API_KEY=
KRX_API_KEY=

# Reserved for a possible future API integration.
# The current Go CLI does not call the OpenAI API.
OPENAI_API_KEY=
OPENAI_MODEL=

# Daily email report. Leave these empty until a provider is selected.
# SMTP_TLS_MODE accepts "starttls" or "implicit"; unencrypted SMTP is rejected.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
EMAIL_FROM=
# Comma-separated recipient addresses.
EMAIL_TO=
EMAIL_SUBJECT_PREFIX=[ForgetMeNot]
EMAIL_REPORT_TIMEZONE=Asia/Seoul
